<Page x:Class="TokiMusic.Views.MinePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="24" Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="16"><PersonPicture x:Name="AvatarPic" Width="64" Height="64" />
      <StackPanel><TextBlock x:Name="NicknameText" Text="未登录" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="MetaText" Text="扫码登录网易云" Opacity="0.6" /></StackPanel></StackPanel>
    <Button Content="二维码登录" Click="Login_Click" />
    <!-- Stats: 收藏歌曲 (/likelist count) · 听歌时长 (estimated from /user/record, labelled) · 歌单数 -->
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Border CornerRadius="34,22,34,22" Background="{StaticResource TokiPrimaryContainerBrush}" Padding="16"><StackPanel><TextBlock x:Name="LikeCountText" Text="0" FontWeight="Bold" FontSize="20" /><TextBlock Text="收藏歌曲" /></StackPanel></Border>
      <Border CornerRadius="34,22,34,22" Background="{StaticResource TokiPrimaryContainerBrush}" Padding="16"><StackPanel><TextBlock x:Name="ListenText" Text="0 小时" FontWeight="Bold" FontSize="20" /><TextBlock Text="听歌时长（排行估算）" /></StackPanel></Border>
      <Border CornerRadius="34,22,34,22" Background="{StaticResource TokiPrimaryContainerBrush}" Padding="16"><StackPanel><TextBlock x:Name="PlaylistCountText" Text="0" FontWeight="Bold" FontSize="20" /><TextBlock Text="歌单" /></StackPanel></Border>
    </StackPanel>
    <Button Content="我的收藏" Click="Entry_Click" Tag="fav" /><Button Content="最近播放" Click="Entry_Click" Tag="recent" /><Button Content="听歌排行" Click="Entry_Click" Tag="record" />
    <TextBlock Text="设置" Style="{StaticResource SubtitleTextBlockStyle}" />
    <TextBox x:Name="ApiBox" Header="API 地址（网易云 API 服务）" Text="http://127.0.0.1:3000" />
    <Button Content="保存 API 地址" Click="SaveApi_Click" />
    <ComboBox x:Name="ThemeBox" Header="主题" SelectedIndex="0"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox>
    <TextBlock x:Name="AboutText" Opacity="0.6" TextWrapping="Wrap" />
  </StackPanel></ScrollViewer>
</Page>
