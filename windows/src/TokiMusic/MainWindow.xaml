<Window x:Class="TokiMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TokiMusic">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <!-- PaneDisplayMode=Auto: sidebar auto-collapses when the window is dragged narrow (Tokinote convention). -->
    <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" SelectionChanged="Nav_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="主页" Tag="Home"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="歌单" Tag="Playlists"><NavigationViewItem.Icon><SymbolIcon Symbol="MusicInfo" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="我的" Tag="Mine"><NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
    <!-- MiniPlayer floats above the content bottom edge. -->
    <Border x:Name="MiniPlayerBar" Grid.Row="1" CornerRadius="26" Margin="16,8" Padding="10" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image x:Name="MiniCover" Width="44" Height="44" />
        <StackPanel Grid.Column="1" Margin="10,0"><TextBlock x:Name="MiniTitle" FontWeight="Bold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="MiniArtist" Opacity="0.6" TextTrimming="CharacterEllipsis" /></StackPanel>
        <Button Grid.Column="2" Content="播放/暂停" Click="MiniToggle_Click" /><Button Grid.Column="3" Content="歌词" Click="MiniLyrics_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
