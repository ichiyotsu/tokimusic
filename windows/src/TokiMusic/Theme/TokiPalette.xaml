<!-- Matcha palette — same hex as Android Color.kt / iOS TokiPalette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="TokiPrimaryLight">#FF4C662B</Color><Color x:Key="TokiPrimaryContainerLight">#FFCDEDA3</Color>
  <Color x:Key="TokiBackgroundLight">#FFF9FAEF</Color><Color x:Key="TokiOnSurfaceVariantLight">#FF44483D</Color>
  <Color x:Key="TokiPrimaryDark">#FFB1D18A</Color><Color x:Key="TokiPrimaryContainerDark">#FF354E16</Color>
  <Color x:Key="TokiBackgroundDark">#FF12140E</Color><Color x:Key="TokiOnSurfaceVariantDark">#FFC5C8BA</Color>
  <SolidColorBrush x:Key="TokiPrimaryBrush" Color="#FF4C662B" />
  <SolidColorBrush x:Key="TokiPrimaryContainerBrush" Color="#FFCDEDA3" />
  <CornerRadius x:Key="TokiCardCornerRadius">34,22,34,22</CornerRadius>
  <CornerRadius x:Key="TokiChipCornerRadius">20,20,20,7</CornerRadius>
  <CornerRadius x:Key="TokiCapsuleCornerRadius">36</CornerRadius>
</ResourceDictionary>
