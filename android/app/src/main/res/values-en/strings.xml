    <!-- Settings · General -->
    <string name="settings_live_updates">Live notification</string>
    <string name="settings_live_updates_desc">Shows the system media player in the notification shade, lock screen and quick settings while playing, with direct playback controls. When off, no notification is shown and background playback may be stopped by the system. Requires notification permission.</string>
    <string name="settings_scrobble">Report listening history</string>
    <string name="settings_scrobble_desc">When on, songs you play from NeteaseMusic are synced to your NeteaseMusic listening history. Only NeteaseMusic songs are reported, and NeteaseMusic login is required.</string>
    <string name="settings_algo_unavailable">Algorithmic recommendations unavailable</string>
    <string name="settings_algo">Algorithmic recommendations</string>
    <string name="settings_algo_desc">When off, recommended playlists and new songs follow the selected source\'s default content and order. When on, they are reordered to your taste. Play records are always kept only on this device (never uploaded) for your taste profile and retrospective playlists; profile data lives in internal storage, survives updates, and is compacted into monthly summaries regularly so it does not grow without limit.</string>
    <string name="settings_check_update_on_start">Check for updates on launch</string>
    <string name="settings_check_update_on_start_desc">Checks for a new version once each time you open the app. When off, checks happen only manually in Settings.</string>
    <string name="settings_update_latest">You are on the latest version</string>
    <string name="settings_update_check_failed">Check failed. Please try again later</string>
