<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.1.18 第 24 项：ExoPlayer WAKE_MODE_NETWORK 需要的唤醒锁/WiFi 锁权限（长播防 Doze 掐流）。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 媒体通知：播放器走 MediaSession 接口，系统发标准媒体通知。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮歌词（0.1.21 追加）：无背景、不可触摸的顶部歌词悬浮窗；需用户在系统设置里授权后才生效，未授权时功能保持关闭。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 第三轮第 15 项：应用内更新——下载 APK 后调起系统安装器。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:name=".TokiMusicApplication" android:label="@string/app_name"
        android:usesCleartextTraffic="true" android:theme="@style/Theme.TokiMusic"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
        <!-- 第六轮第 29 项：singleTop——从通知栏媒体卡片点进时走 onNewIntent
             回到已有播放器页，不再另起一个 Activity 叠在上面。 -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".player.PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService" /></intent-filter>
        </service>
        <!-- 第三轮第 15 项：更新包 FileProvider（cacheDir/update/ 对外授临时读权限）。 -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
